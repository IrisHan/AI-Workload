# Optional. Unset uses <repository>/data/planner.db.
# DATABASE_URL=sqlite:////absolute/path/planner.db

# Optional. Unset uses 8666. The process always binds 127.0.0.1.
# PORT=8666

# Used only by frontend end-to-end tests. Do not point this at the working database.
# PLANNER_E2E_DATABASE_URL=sqlite:////tmp/ai-workload-e2e/test.db
# PLANNER_E2E_EVIDENCE=/tmp/ai-workload-e2e

# Optional package index for make setup.
# PIP_INDEX_URL=https://pypi.org/simple
# PYTHON=python3.11
